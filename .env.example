# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://mhvlhmkbwmbmyurihfqa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Solo servidor. Supabase > Project Settings > API Keys > service_role (NUNCA en el navegador)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ---------- Wompi ----------
# Dashboard Wompi > Desarrolladores. Usa las llaves de pruebas (pub_test_...) mientras desarrollas.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
# Desarrolladores > Secretos para integración técnica > Integridad
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
# Desarrolladores > Secretos para integración técnica > Eventos
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx

# ---------- Sitio ----------
# URL pública del sitio (a donde Wompi devuelve al cliente)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary: lo usan el panel de administración (subir fotos) y los scripts
CLOUDINARY_CLOUD_NAME=unjfzz2h
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
